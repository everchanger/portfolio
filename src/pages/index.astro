---
import Layout from "../layouts/index.astro";
import { experience } from "../data/experience.js";

const recentExperience = experience.slice(0, 3);
const expertise = [
  {
    title: "Application development",
    description: "TypeScript, Fastify, TypeBox, Vue, Nuxt, PHP, Laravel, and C++.",
  },
  {
    title: "Cloud & platform",
    description: "AWS, Kubernetes, EKS, Karpenter, KEDA, OpenShift, and Docker.",
  },
  {
    title: "Architecture",
    description: "Microservices, API design, and frontend architecture.",
  },
];
---

<Layout
  description="Joakim Rosenstam is a principal fullstack developer at Configura, based in Motala, Sweden. He builds TypeScript services and cloud platforms."
>
  <main>
    <section id="about" class="grid scroll-mt-8 items-center gap-12 py-16 sm:py-24 md:grid-cols-[1fr_260px] md:gap-16">
      <div>
        <p class="mb-5 text-xs font-semibold uppercase tracking-[0.18em] text-accent">
          Principal Fullstack Developer <span class="px-1 text-line">/</span> Motala, Sweden
        </p>
        <h1 class="max-w-3xl text-4xl font-semibold leading-[1.08] tracking-[-0.045em] text-ink sm:text-6xl">
          Joakim Rosenstam
        </h1>
        <p class="mt-6 max-w-2xl text-lg leading-8 text-muted">
          I’m a software developer currently working on Configura’s content platform. Previously, I worked on e-commerce at Dahl, web applications at Perido and Webhallen, and secure systems at Expisoft.
        </p>
        <div class="mt-8 flex flex-wrap items-center gap-3">
          <a href="#experience" class="rounded-md bg-accent px-5 py-3 text-sm font-medium text-canvas transition-colors hover:bg-accent-dark">
            Recent experience
          </a>
          <a href="/cv/" class="rounded-md border border-line bg-paper px-5 py-3 text-sm font-medium text-ink transition-colors hover:border-accent">
            Full career history
          </a>
        </div>
      </div>
      <div class="mx-auto w-56 md:mx-0 md:w-full">
        <div class="rounded-2xl border border-line bg-paper p-3 shadow-soft">
          <img
            src="/assets/joakim.jpg"
            alt="Portrait of Joakim Rosenstam"
            width="256"
            height="256"
            fetchpriority="high"
            class="aspect-square w-full rounded-xl object-cover"
          />
        </div>
      </div>
    </section>

    <section class="grid gap-8 border-y border-line py-9 sm:grid-cols-3 sm:gap-10">
      <div>
        <p class="text-xs font-semibold uppercase tracking-[0.16em] text-muted">Current focus</p>
        <p class="mt-2 font-medium text-ink">Cloud-native content platform</p>
      </div>
      <div>
        <p class="text-xs font-semibold uppercase tracking-[0.16em] text-muted">Building with</p>
        <p class="mt-2 font-medium text-ink">TypeScript · Fastify · AWS EKS</p>
      </div>
      <div>
        <p class="text-xs font-semibold uppercase tracking-[0.16em] text-muted">Based in</p>
        <p class="mt-2 font-medium text-ink">Motala, Östergötland, Sweden</p>
      </div>
    </section>

    <section id="experience" class="scroll-mt-8 py-16 sm:py-20">
      <div class="flex flex-wrap items-end justify-between gap-5">
        <div>
          <p class="text-xs font-semibold uppercase tracking-[0.18em] text-accent">Career</p>
          <h2 class="mt-2 text-3xl font-semibold tracking-tight text-ink">Experience</h2>
        </div>
        <a href="/cv/" class="text-sm font-medium text-accent transition-colors hover:text-accent-dark">
          Full career history <span aria-hidden="true">→</span>
        </a>
      </div>
      <div class="mt-8 divide-y divide-line border-y border-line">
        {recentExperience.map((job) => (
          <article class="grid gap-3 py-7 sm:grid-cols-[190px_1fr] sm:gap-8">
            <p class="pt-1 text-sm text-muted">{job.period}</p>
            <div>
              <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
                <h3 class="text-lg font-semibold text-ink">{job.role}</h3>
                <p class="text-sm text-muted">{job.company} · {job.location}</p>
              </div>
              <p class="mt-3 max-w-3xl leading-7 text-muted">{job.summary[0]}</p>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section id="expertise" class="scroll-mt-8 border-t border-line py-16 sm:py-20">
      <div class="max-w-2xl">
        <p class="text-xs font-semibold uppercase tracking-[0.18em] text-accent">Technologies</p>
        <h2 class="mt-2 text-3xl font-semibold tracking-tight text-ink">Tools and technologies</h2>
        <p class="mt-4 leading-7 text-muted">
          My work has included C++ and secure systems, web applications, e-commerce, and cloud platforms.
        </p>
      </div>
      <div class="mt-9 grid gap-px overflow-hidden rounded-xl border border-line bg-line md:grid-cols-3">
        {expertise.map((item) => (
          <article class="bg-paper p-6 sm:p-7">
            <h3 class="font-semibold text-ink">{item.title}</h3>
            <p class="mt-3 text-sm leading-6 text-muted">{item.description}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="mb-10 rounded-2xl border border-line bg-paper px-6 py-10 sm:px-10 sm:py-12">
      <div class="flex flex-col justify-between gap-6 sm:flex-row sm:items-center">
        <div>
          <h2 class="text-2xl font-semibold tracking-tight text-ink">Contact</h2>
          <p class="mt-2 text-sm leading-6 text-muted">You can reach me by email or find me on LinkedIn and GitHub.</p>
        </div>
        <a href="mailto:joakim.rosenstam@gmail.com" class="w-fit rounded-md bg-accent px-5 py-3 text-sm font-semibold text-canvas transition-colors hover:bg-accent-dark">
          Email Joakim
        </a>
      </div>
    </section>
  </main>
</Layout>

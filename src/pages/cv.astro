---
import Layout from "../layouts/index.astro";
import { education, experience } from "../data/experience.js";
---

<Layout
  title="Career history — Joakim Rosenstam"
  description="Career history and education for Joakim Rosenstam, principal fullstack developer."
>
  <main class="mx-auto max-w-4xl py-14 sm:py-20">
    <p class="text-xs font-semibold uppercase tracking-[0.18em] text-forest">Career history</p>
    <div class="mt-3 flex flex-wrap items-end justify-between gap-4">
      <div>
        <h1 class="text-4xl font-semibold tracking-[-0.04em] text-ink sm:text-5xl">Experience & education</h1>
        <p class="mt-4 max-w-2xl leading-7 text-muted">
          A career across cloud platforms, web products, secure systems, and game development.
        </p>
      </div>
      <a href="mailto:joakim.rosenstam@gmail.com" class="text-sm font-medium text-forest hover:text-forest-dark">Get in touch <span aria-hidden="true">→</span></a>
    </div>

    <section aria-labelledby="experience-heading" class="mt-12">
      <h2 id="experience-heading" class="sr-only">Work experience</h2>
      <div class="divide-y divide-line border-y border-line">
        {experience.map((job) => (
          <article class="grid gap-3 py-8 sm:grid-cols-[190px_1fr] sm:gap-8">
            <p class="pt-1 text-sm text-muted">{job.period}</p>
            <div>
              <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
                <div>
                  <h3 class="text-lg font-semibold text-ink">{job.role}</h3>
                  <p class="mt-1 font-medium text-forest">{job.company}</p>
                </div>
                {job.location && <p class="text-sm text-muted">{job.location}</p>}
              </div>
              <div class="mt-4 max-w-3xl space-y-3 text-sm leading-7 text-muted">
                {job.summary.map((paragraph) => <p>{paragraph}</p>)}
              </div>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="mt-14 border-t border-line pt-8">
      <p class="text-xs font-semibold uppercase tracking-[0.18em] text-forest">Education</p>
      {education.map((item) => (
        <article class="mt-5 grid gap-2 sm:grid-cols-[190px_1fr] sm:gap-8">
          <p class="text-sm text-muted">{item.period}</p>
          <div>
            <h2 class="font-semibold text-ink">{item.qualification}</h2>
            <p class="mt-1 text-sm text-muted">{item.institution}</p>
          </div>
        </article>
      ))}
    </section>
  </main>
</Layout>

---
import Layout from "../layouts/index.astro";
---

<Layout
  title="Projects — Joakim Rosenstam"
  description="Explore Joakim Rosenstam’s public code and experiments on GitHub."
>
  <main class="mx-auto max-w-3xl py-20 sm:py-28">
    <p class="text-xs font-semibold uppercase tracking-[0.18em] text-accent">Projects & experiments</p>
    <h1 class="mt-3 text-4xl font-semibold tracking-[-0.04em] text-ink sm:text-5xl">Code in progress.</h1>
    <p class="mt-5 max-w-2xl leading-7 text-muted">
      My public repositories and experiments live on GitHub. For a clearer picture of my professional work, see my career history.
    </p>
    <div class="mt-8 flex flex-wrap gap-3">
      <a href="https://github.com/everchanger" target="_blank" rel="noreferrer" class="rounded-md bg-accent px-5 py-3 text-sm font-medium text-white transition-colors hover:bg-accent-dark">
        Browse GitHub <span aria-hidden="true">↗</span>
      </a>
      <a href="/cv" class="rounded-md border border-line bg-paper px-5 py-3 text-sm font-medium text-ink transition-colors hover:border-accent">
        View career history
      </a>
    </div>
  </main>
</Layout>

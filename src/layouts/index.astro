---
import "../styles/global.css";

const {
  title = "Joakim Rosenstam — Principal Fullstack Developer",
  description = "Joakim Rosenstam is a principal fullstack developer based in Motala, Sweden.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f7f7f4" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body class="bg-canvas font-sans text-ink antialiased">
    <div class="mx-auto min-h-screen max-w-6xl px-5 sm:px-8">
      <header class="flex flex-wrap items-center justify-between gap-x-8 gap-y-4 border-b border-line py-6">
        <a href="/" class="text-sm font-semibold tracking-tight text-ink">
          Joakim Rosenstam
        </a>
        <nav aria-label="Main navigation" class="flex flex-wrap items-center gap-x-6 gap-y-2 text-sm text-muted">
          <a class="transition-colors hover:text-ink" href="/#about">About</a>
          <a class="transition-colors hover:text-ink" href="/#experience">Experience</a>
          <a class="transition-colors hover:text-ink" href="/#expertise">Expertise</a>
          <a class="transition-colors hover:text-ink" href="/cv">Full CV</a>
          <a
            class="rounded-md bg-forest px-3 py-2 font-medium text-white transition-colors hover:bg-forest-dark"
            href="mailto:joakim.rosenstam@gmail.com"
          >Get in touch</a>
        </nav>
      </header>
      <slot />
      <footer class="mt-24 flex flex-col gap-3 border-t border-line py-7 text-sm text-muted sm:flex-row sm:items-center sm:justify-between">
        <p>Joakim Rosenstam · Motala, Sweden</p>
        <div class="flex gap-5">
          <a class="transition-colors hover:text-ink" href="https://www.linkedin.com/in/jrosenstam/" target="_blank" rel="noreferrer">LinkedIn</a>
          <a class="transition-colors hover:text-ink" href="https://github.com/everchanger" target="_blank" rel="noreferrer">GitHub</a>
          <a class="transition-colors hover:text-ink" href="mailto:joakim.rosenstam@gmail.com">Email</a>
        </div>
      </footer>
    </div>
  </body>
</html>
